# Copy to .env for local development. Never commit .env.

# Used by the API and Alembic when run on the host (uv run ...). Neon/Render strings
# (postgres://…?sslmode=require) work as pasted; see "Deploying" in backend/CLAUDE.md.
DATABASE_URL=postgresql+asyncpg://overload:overload@localhost:5432/overload

# Signs access tokens. At least 32 characters, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Browser origins allowed to call the API, comma-separated (the Expo web dev server by
# default). Phones don't need this.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Access token lifetime in days.
ACCESS_TOKEN_TTL_DAYS=30

# Log SQL statements.
SQL_ECHO=false

# Used by docker compose for the Postgres container (defaults shown).
POSTGRES_USER=overload
POSTGRES_PASSWORD=overload
POSTGRES_DB=overload
